# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# Find your account ID in Snowflake web UI → Account dropdown

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production
SECRET_KEY=generate_a_random_secret_key_here
PORT=5000

# ============================================================================
# TABLEAU CONFIGURATION (Optional - for embedded dashboards)
# ============================================================================
TABLEAU_SERVER_URL=https://online.tableau.com
TABLEAU_SITE_ID=your_site_id
TABLEAU_CLIENT_ID=your_client_id
TABLEAU_CLIENT_SECRET=your_client_secret
TABLEAU_WORKBOOK_NAME=SaaS-Analytics
TABLEAU_DASHBOARD_NAME=Executive-Summary

# ============================================================================
# RENDER DEPLOYMENT (Set automatically on Render)
# ============================================================================
# PORT=5000  # Set by Render automatically
